{
  "name": "network-sizer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "remoteUser": "node",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "network-sizer",
      "onAutoForward": "openBrowser",
      "visibility": "private",
      "requireLocalPort": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
